{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.meeting-intelligence/schemas/evidence_merge_result.schema.json",
  "title": "Evidence Merge Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meeting_id",
    "merge_model",
    "prompt_version",
    "merged_evidence_items",
    "merge_log",
    "ambiguities"
  ],
  "properties": {
    "meeting_id": {
      "type": "string",
      "minLength": 1
    },
    "merge_model": {
      "type": "string",
      "minLength": 1
    },
    "prompt_version": {
      "type": "string",
      "minLength": 1
    },
    "merged_evidence_items": {
      "type": "array",
      "items": {
        "$ref": "evidence_item.schema.json"
      }
    },
    "merge_log": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "merged_into",
          "source_evidence_ids",
          "reason"
        ],
        "properties": {
          "merged_into": {
            "type": "string"
          },
          "source_evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "ambiguities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ambiguity_id",
          "description",
          "conflicting_evidence_ids",
          "required_resolution"
        ],
        "properties": {
          "ambiguity_id": {
            "type": "string",
            "pattern": "^AMB-[0-9]{4,}$"
          },
          "description": {
            "type": "string"
          },
          "conflicting_evidence_ids": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          },
          "required_resolution": {
            "type": "string"
          }
        }
      }
    }
  }
}
