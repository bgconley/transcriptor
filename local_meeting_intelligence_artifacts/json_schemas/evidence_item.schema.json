{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.meeting-intelligence/schemas/evidence_item.schema.json",
  "title": "Meeting Evidence Item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_id",
    "meeting_id",
    "chunk_id",
    "item_type",
    "domain",
    "statement",
    "explicitness",
    "speaker",
    "speaker_org",
    "segment_ids",
    "timestamp_start",
    "timestamp_end",
    "evidence_quote",
    "quote_match_status",
    "confidence",
    "requires_human_review",
    "extraction_model",
    "prompt_version"
  ],
  "properties": {
    "evidence_id": {
      "type": "string",
      "pattern": "^(EVID|REQ|RISK|OQ|DEC|ACT|FACT|IMP)-[0-9]{4,}$"
    },
    "meeting_id": {
      "type": "string"
    },
    "chunk_id": {
      "type": "string"
    },
    "item_type": {
      "type": "string",
      "enum": [
        "environment_fact",
        "requirement",
        "constraint",
        "design_driver",
        "risk",
        "open_question",
        "decision",
        "action_item",
        "nutanix_guidance",
        "architectural_concept",
        "architectural_implication",
        "speaker_attribution",
        "commercial_detail",
        "timeline_detail"
      ]
    },
    "domain": {
      "type": "string",
      "enum": [
        "business_context",
        "current_infrastructure",
        "workloads_applications",
        "networking",
        "storage_data",
        "security_compliance_governance",
        "operations_support",
        "migration",
        "dr_bc",
        "cost_commercial",
        "azure",
        "nc2",
        "nutanix_platform",
        "identity",
        "monitoring",
        "performance",
        "participants",
        "general"
      ]
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "explicitness": {
      "type": "string",
      "enum": [
        "transcript_stated",
        "reasonable_inference",
        "architectural_implication",
        "risk",
        "open_question"
      ]
    },
    "speaker": {
      "type": "object",
      "required": [
        "label",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low",
            "unknown"
          ]
        }
      }
    },
    "speaker_org": {
      "type": "string",
      "enum": [
        "customer",
        "nutanix",
        "partner",
        "unknown"
      ]
    },
    "segment_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "timestamp_start": {
      "type": "string",
      "pattern": "^([0-9]+(\\.[0-9]{1,3})?|[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?)$"
    },
    "timestamp_end": {
      "type": "string",
      "pattern": "^([0-9]+(\\.[0-9]{1,3})?|[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?)$"
    },
    "evidence_quote": {
      "type": "string",
      "minLength": 1
    },
    "quote_match_status": {
      "type": "string",
      "enum": [
        "exact_match",
        "normalized_match",
        "unverified"
      ]
    },
    "normalized_terms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "requires_human_review": {
      "type": "boolean"
    },
    "review_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_stage": {
      "type": "string",
      "enum": [
        "domain_extraction",
        "missed_detail_scan",
        "evidence_consolidation",
        "human_correction"
      ]
    },
    "source_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "extraction_model": {
      "type": "string"
    },
    "prompt_version": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
